<?xml version="1.0" encoding="utf-8"?>
<!-- The auth token is encrypted with a Keystore key that is never backed up, so exclude it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
